# Nginx 反向代理配置示例 (Enterprise Hub Gateway)
# 适用场景：部署在企业私网或公有云服务器，前面通过 Nginx 暴露 HTTPS
# 重点：LLM 流式输出 (SSE) 必须禁用 proxy_buffering，并延长 read_timeout

server {
    listen 80;
    server_name codex-hub.yourcompany.internal;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name codex-hub.yourcompany.internal;

    # SSL 证书配置
    ssl_certificate     /etc/ssl/certs/enterprise.crt;
    ssl_certificate_key /etc/ssl/private/enterprise.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 客户端上传限制 (插件包 / 市场 ZIP 上传)
    client_max_body_size 50M;

    # 根反代到企业管理端后端 (默认 28473 端口)
    location / {
        proxy_pass http://127.0.0.1:28473;

        # 标准代理头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 支持 (状态监听与实时推送)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 核心：支持 LLM 流式输出 (SSE - Server-Sent Events)
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        # 核心：超时时间配置 (适配推理模型 o1 / DeepSeek-R1 长耗时响应)
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
