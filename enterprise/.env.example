# Copy to .env and fill in. Generate secrets with:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -base64 32   (SECRETS_KEY — must decode to exactly 32 bytes; keep it safe,
#                              losing it makes stored upstream API keys unreadable)
POSTGRES_PASSWORD=
JWT_SECRET=
SECRETS_KEY=
ADMIN_USERNAME=admin
# Initial admin password, only used when the users table is empty (min 6 chars).
ADMIN_PASSWORD=
TRUST_PROXY=true
LOG_LEVEL=info
# Optional: Sub2API admin panel for ChatGPT/Codex 5h/7d windows.
SUB2API_URL=
SUB2API_EMAIL=
SUB2API_PASSWORD=
# Optional HTTP(S) proxy for Sub2API admin queries and model requests at the same origin.
# Docker: http://user:password@host.docker.internal:17890 (URL-encode credentials).
SUB2API_PROXY_URL=

# Optional: Volcengine Ark Coding Plan quota query (server only; NOT the inference API key).
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_REGION=cn-beijing
VOLCENGINE_PROVIDER_ID=volcengine-coding

# Local screenshot-like accounts; ignored in production.
DEMO_UPSTREAM_ACCOUNTS=false
